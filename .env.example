# Copy this file to .env and replace every example value before a real run.
# .env is machine-specific/private and MUST NOT be committed.
# Documentation addresses and REPLACE_WITH values are rejected by real-runtime validation.

PB_VM_IPV4=192.0.2.20
# PB_VM_IPV6=2001:db8:1::20

PB_VPS_IPV4=198.51.100.10
# PB_VPS_IPV6=2001:db8:2::10

PB_ENDPOINT_A_PORT=41001
PB_ENDPOINT_B_PORT=41002

PB_SOCKS_HOST=192.0.2.30
PB_SOCKS_PORT=10808
PB_SOCKS_PROXY_CONFIG_ID=1

PB_CLIENT_EXE=C:\ProxyBridge-TestLab\bin\pb_net_client.exe
PB_PROXYBRIDGE_EXE=C:\Program Files\ProxyBridge\ProxyBridge.exe
PB_PROXYBRIDGE_CLI_EXE=C:\Program Files\ProxyBridge\ProxyBridge_CLI.exe
PB_DRIVER_PATH=C:\Windows\System32\drivers\ProxyBridgeDrv.sys
PB_PROXYBRIDGE_SERVICE=ProxyBridgeDrv
PB_EVIDENCE_ROOT=C:\ProxyBridge-TestLab\evidence

PB_EXPECTED_CLIENT_SHA256=REPLACE_WITH_64_HEX_SHA256
PB_EXPECTED_PROXYBRIDGE_CLI_SHA256=REPLACE_WITH_64_HEX_SHA256
PB_EXPECTED_PROXYBRIDGE_EXE_SHA256=REPLACE_WITH_64_HEX_SHA256
PB_EXPECTED_DRIVER_SHA256=REPLACE_WITH_64_HEX_SHA256

PB_SSH_HOST=proxy-test.example.com
PB_SSH_USER=tester
PB_SSH_PORT=22
PB_SSH_KEY=C:\Users\Tester\.ssh\id_ed25519
PB_VPS_SERVER_LOG=/home/tester/proxybridge-testlab/logs/server.jsonl
