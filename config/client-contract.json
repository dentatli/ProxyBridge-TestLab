{
  "schema_version": 1,
  "contract_id": "proxybridge-client-stage34",
  "output_contract": {
    "machine_records": "jsonl_file_only",
    "stdout": "human_text",
    "stderr": "human_text"
  },
  "allowed_arguments": [
    "--mode", "--family", "--protocol", "--first-protocol", "--udp-mode",
    "--close-mode", "--tcp-peer-policy", "--first-tcp-peer-policy",
    "--second-tcp-peer-policy", "--expected-action", "--first-expected-action",
    "--second-expected-action", "--expect", "--first-expect", "--second-expect",
    "--local-ip", "--remote-ip", "--local-port", "--tcp-remote-port",
    "--udp-remote-port", "--first-remote-ip", "--first-remote-port",
    "--second-remote-ip", "--second-remote-port", "--inter-flow-wait-ms",
    "--timeout-ms", "--bind-retry-count", "--bind-retry-delay-ms",
    "--test-id", "--run-id", "--jsonl-log"
  ],
  "forbidden_arguments": [
    "--mode base", "--socket-mode", "--remote-port", "--payload-size",
    "--second-protocol", "--hold-first", "--recheck-first"
  ],
  "modes": {
    "base": {
      "acceptance": "exact-single-harness-contract",
      "harness_mode": "single",
      "argument_order": [
        "--mode", "--family", "--protocol", "--udp-mode-if-udp",
        "--tcp-peer-policy-if-tcp", "--local-ip", "--local-port",
        "--remote-ip", "--tcp-remote-port-or-udp-remote-port",
        "--expected-action", "--expect", "--timeout-ms",
        "--test-id", "--run-id", "--jsonl-log"
      ],
      "unsupported_arguments": ["--socket-mode", "--remote-port", "--payload-size"]
    },
    "issue206": {
      "acceptance": "accepted-stage-3.4a-3.4b",
      "same_local_port_reuse": true,
      "argument_order": [
        "--mode", "--family", "--local-ip", "--local-port", "--remote-ip",
        "--first-remote-ip", "--first-remote-port", "--second-remote-ip",
        "--second-remote-port", "--close-mode", "--first-expected-action",
        "--second-expected-action", "--first-expect", "--second-expect",
        "--first-tcp-peer-policy", "--second-tcp-peer-policy", "--timeout-ms",
        "--bind-retry-count", "--bind-retry-delay-ms", "--test-id", "--run-id",
        "--jsonl-log"
      ]
    },
    "issue209": {
      "acceptance": "exact-three-record-harness-contract",
      "same_numeric_local_port": true,
      "record_phases": ["first_flow", "second_flow", "held_recheck"],
      "second_protocol": "opposite-of-first",
      "argument_order": [
        "--mode", "--family", "--first-protocol", "--udp-mode",
        "--local-ip", "--local-port", "--first-remote-ip", "--first-remote-port",
        "--second-remote-ip", "--second-remote-port", "--first-expected-action",
        "--second-expected-action", "--first-expect", "--second-expect",
        "--first-tcp-peer-policy", "--second-tcp-peer-policy",
        "--inter-flow-wait-ms", "--timeout-ms", "--bind-retry-count",
        "--bind-retry-delay-ms", "--test-id", "--run-id", "--jsonl-log"
      ],
      "unsupported_arguments": ["--second-protocol", "--hold-first", "--recheck-first"]
    }
  }
}
