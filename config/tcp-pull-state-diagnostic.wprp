    <Profile Id="TestLabTcpPullState.Verbose.File" Name="TestLabTcpPullState" Description="Bounded scheduling, kernel TCP metadata and TCP state diagnosis; no per-packet TCPIP provider level" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="TestLabSystemCollector">
          <SystemProviderId Value="TestLabSystemProvider" />
        </SystemCollectorId>
        <EventCollectorId Value="TestLabTcpStateCollector"><EventProviders><EventProviderId Value="TestLabTcpStateProvider" /></EventProviders></EventCollectorId>
      </Collectors>
    </Profile>
    <Profile Id="TestLabTcpPullState.Verbose.Memory" Name="TestLabTcpPullState" Base="TestLabTcpPullState.Verbose.File" Description="Thread scheduling and kernel TCP metadata" LoggingMode="Memory" DetailLevel="Verbose" />
  </Profiles>
</WindowsPerformanceRecorder>
