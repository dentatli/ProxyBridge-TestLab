        <Keyword Value="ReadyThread" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="DPC" />
        <Keyword Value="Interrupt" />
        <Keyword Value="NetworkTrace" />
      </Keywords>
      <Stacks>
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
        <Stack Value="SampledProfile" />
      </Stacks>
    </SystemProvider>
    <EventProvider Id="TestLabTcpStateProvider" Name="2f07e2ee-15db-40f1-90ef-9d7ba282188a" Strict="true" NonPagedMemory="true" Level="5">
      <Keywords><Keyword Value="0x87" /></Keywords>
      <EventFilters FilterIn="true">
        <EventId Value="1001" />
        <EventId Value="1002" />
