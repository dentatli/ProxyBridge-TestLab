$$ STAGE ONLY. bl must be empty immediately before loading. Run once per reviewed session.
$$ Require MASM evaluator. Inspect .expr before loading. Do not change evaluator blindly.
$$ Appends 14 automatically numbered points, then disables exactly IDs 0 through 13.
$$ Preserve the existing host log. No workload, driver install, reboot, enable or final g.
bp tcpip!AlepCreateRedirectRecord+0x38f ".printf \"PBKD CREATE_PRE thread=%p stack=%p ep=%p previous=%p record=%p context=%p size=%I64x refs=%x familyA=%x portA=%x addrA=%x familyB=%x portB=%x addrB=%x\\n\", @$thread, @rsp, @rdi, poi(@rdi+0x1c0), @rax, poi(@rax+0x1e0), poi(@rax+0x1e8), dwo(@rax+0x1f0), wo(@rax+0x48), wo(@rax+0x4a), dwo(@rax+0x4c), wo(@rax+0xc8), wo(@rax+0xca), dwo(@rax+0xcc); g"
bp tcpip!AlepCreateRedirectRecord+0x396 ".printf \"PBKD CREATE_POST thread=%p stack=%p ep=%p assigned=%p record=%p\\n\", @$thread, @rsp, @rdi, poi(@rdi+0x1c0), @rax; g"
bp tcpip!InitializeEndpointContextFromParentContext+0x174 ".printf \"PBKD TRANSFER_READ thread=%p stack=%p child=%p parent=%p parent_record=%p child_record=%p\\n\", @$thread, @rsp, @rbx, @rdi, poi(@rdi+0x1c0), poi(@rbx+0x1c0); g"
bp tcpip!InitializeEndpointContextFromParentContext+0x1d7 ".printf \"PBKD TRANSFER_PRE thread=%p stack=%p child=%p parent=%p record=%p child_record=%p\\n\", @$thread, @rsp, @rbx, @rdi, @rax, poi(@rbx+0x1c0); g"
bp tcpip!InitializeEndpointContextFromParentContext+0x1e6 ".printf \"PBKD TRANSFER_POST thread=%p stack=%p child=%p parent=%p child_record=%p parent_record=%p\\n\", @$thread, @rsp, @rbx, @rdi, poi(@rbx+0x1c0), poi(@rdi+0x1c0); g"
bp tcpip!AleRedirectRecordDereference+0xc ".printf \"PBKD DEREF_PRE thread=%p stack=%p record=%p refs=%x\\n\", @$thread, @rsp, @rcx, dwo(@rcx+0x1f0); g"
bp tcpip!AleRedirectRecordDereference+0x14 ".printf \"PBKD DEREF_POST thread=%p stack=%p record=%p previous_refs=%x refs=%x\\n\", @$thread, @rsp, @rcx, @eax, dwo(@rcx+0x1f0); g"
bp tcpip!AleRedirectRecordFree+0xd ".printf \"PBKD FREE_ENTER thread=%p stack=%p slot=%p record=%p refs=%x context=%p size=%I64x\\n\", @$thread, @rsp, @rcx, @rbx, dwo(@rbx+0x1f0), poi(@rbx+0x1e0), poi(@rbx+0x1e8); g"
