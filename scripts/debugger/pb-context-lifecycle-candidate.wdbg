bp tcpip!AleRedirectRecordFree+0x76 ".printf \"PBKD FREE_POOL_RETURN thread=%p stack=%p former_record_address=%p\\n\", @$thread, @rsp, @rbx; g"
bp tcpip!WfpAleProcessSocketOption+0x2c4 ".printf \"PBKD QUERY_READ thread=%p stack=%p ep=%p record=%p ioctl=%x\\n\", @$thread, @rsp, @rdi, poi(@rdi+0x1c0), @r15d; g"
bp tcpip!WfpAleProcessSocketOption+0x47b ".if (@r15d == 0x980000dd) { .printf \"PBKD QUERY_STATUS thread=%p stack=%p ep=%p record=%p status=%x\\n\", @$thread, @rsp, @rdi, poi(@rdi+0x1c0), @ebx; gc; } .else { gc; }"
bp tcpip!WfpPoolFree+0x1a ".if (poi(@rsp+0x28) == tcpip!AleRedirectRecordFree+0x76) { .printf \"PBKD ALLOCATOR_FREE_CALL thread=%p stack=%p slot=%p record=%p allocator_return=%p\\n\", @$thread, @rsp, @rbx, @rcx, tcpip!WfpPoolFree+0x1f; gc; } .else { gc; }"
bp tcpip!WfpPoolFree+0x1f ".if (poi(@rsp+0x28) == tcpip!AleRedirectRecordFree+0x76) { .printf \"PBKD ALLOCATOR_FREE_RETURN thread=%p stack=%p slot=%p former_record_address=%p\\n\", @$thread, @rsp, @rbx, poi(@rbx); gc; } .else { gc; }"
