    {
      "id": "protocol-http-direct", "title": "HTTP/1.1 follows DIRECT", "protocol": "TCP", "action": "DIRECT", "port_expression": "${PB_PROTOCOL_HTTP_PORT}", "remote_port": "${PB_PROTOCOL_HTTP_PORT}", "tags": ["http", "http1"],
      "protocol_worker": { "plugin_id": "protocol-http", "protocol_family": "http1", "transport": "TCP", "evidence_profile_id": "http1-transaction", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_HTTP_PORT}", "authority": "proxybridge-testlab.test", "path": "/probe", "use_tls": false }, "expected": { "status_code": 200 } }
    },
