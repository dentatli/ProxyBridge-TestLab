{
  "schema_version": 1,
  "catalog_id": "protocol-core",
  "defaults": {
    "enabled": true,
    "executor_kind": "protocol-worker",
    "implementation_status": "EXECUTABLE",
    "implementation_reason": "A protocol-aware local worker and controlled TestLab server endpoint provide independent evidence.",
    "family": 4,
    "selector": "basename",
    "socket_mode": "connected",
    "tags": ["synthetic", "correctness", "protocol-aware", "milestone-12"],
    "requires": ["protocol_worker", "server_python_protocols"],
    "mock_fixture_id": "protocol-generated"
  },
  "scenarios": [
    {
      "id": "protocol-dns-udp-direct", "title": "DNS over UDP follows DIRECT", "protocol": "UDP", "action": "DIRECT", "port_expression": "${PB_PROTOCOL_DNS_PORT}", "remote_port": "${PB_PROTOCOL_DNS_PORT}", "tags": ["dns", "dns-udp"],
      "protocol_worker": { "plugin_id": "protocol-dns", "protocol_family": "dns-classic", "transport": "UDP", "evidence_profile_id": "dns-transaction", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_DNS_PORT}", "dns_transport": "UDP", "query_name": "a.probe.test.", "query_type": "A" }, "expected": { "response_code": 0, "answers": ["192.0.2.123"] } }
    },
    {
      "id": "protocol-dns-udp-block", "title": "DNS over UDP follows BLOCK", "protocol": "UDP", "action": "BLOCK", "port_expression": "${PB_PROTOCOL_DNS_PORT}", "remote_port": "${PB_PROTOCOL_DNS_PORT}", "tags": ["dns", "dns-udp"],
      "protocol_worker": { "plugin_id": "protocol-dns", "protocol_family": "dns-classic", "transport": "UDP", "evidence_profile_id": "dns-transaction", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_DNS_PORT}", "dns_transport": "UDP", "query_name": "blocked.probe.test.", "query_type": "A" }, "expected": {} }
    },
    {
      "id": "protocol-dns-udp-proxy", "title": "DNS over UDP follows PROXY", "protocol": "UDP", "action": "PROXY", "port_expression": "${PB_PROTOCOL_DNS_PORT}", "remote_port": "${PB_PROTOCOL_DNS_PORT}", "tags": ["dns", "dns-udp"],
      "protocol_worker": { "plugin_id": "protocol-dns", "protocol_family": "dns-classic", "transport": "UDP", "evidence_profile_id": "dns-transaction", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_DNS_PORT}", "dns_transport": "UDP", "query_name": "a.probe.test.", "query_type": "A" }, "expected": { "response_code": 0, "answers": ["192.0.2.123"] } }
    },
    {
      "id": "protocol-dns-tcp-direct", "title": "DNS over TCP follows DIRECT", "protocol": "TCP", "action": "DIRECT", "port_expression": "${PB_PROTOCOL_DNS_PORT}", "remote_port": "${PB_PROTOCOL_DNS_PORT}", "tags": ["dns", "dns-tcp"],
