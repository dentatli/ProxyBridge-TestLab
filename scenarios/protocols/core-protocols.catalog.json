    },
    {
      "id": "protocol-tls-proxy", "title": "TLS session follows PROXY", "protocol": "TCP", "action": "PROXY", "port_expression": "${PB_PROTOCOL_TLS_PORT}", "remote_port": "${PB_PROTOCOL_TLS_PORT}", "tags": ["tls"], "requires": ["server_tls_pki"],
      "protocol_worker": { "plugin_id": "protocol-tls", "protocol_family": "tls", "transport": "TCP", "evidence_profile_id": "tls-session", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_TLS_PORT}", "server_name": "proxybridge-testlab.test", "ca_path": "${PB_PROTOCOL_CA_PEM}" }, "expected": { "result": "PASS" } }
