      "id": "protocol-http-block", "title": "HTTP/1.1 follows BLOCK", "protocol": "TCP", "action": "BLOCK", "port_expression": "${PB_PROTOCOL_HTTP_PORT}", "remote_port": "${PB_PROTOCOL_HTTP_PORT}", "tags": ["http", "http1"],
