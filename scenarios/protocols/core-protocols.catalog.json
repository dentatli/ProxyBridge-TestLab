      "protocol_worker": { "plugin_id": "protocol-http", "protocol_family": "http1", "transport": "TCP", "evidence_profile_id": "http1-transaction", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_HTTP_PORT}", "authority": "proxybridge-testlab.test", "path": "/probe", "use_tls": false }, "expected": { "status_code": 200 } }
    },
    {
      "id": "protocol-https-direct", "title": "HTTPS over HTTP/1.1 follows DIRECT", "protocol": "TCP", "action": "DIRECT", "port_expression": "${PB_PROTOCOL_HTTPS_PORT}", "remote_port": "${PB_PROTOCOL_HTTPS_PORT}", "tags": ["https", "http1", "tls"], "requires": ["server_tls_pki"],
      "protocol_worker": { "plugin_id": "protocol-http", "protocol_family": "http1", "transport": "TCP", "evidence_profile_id": "http1-transaction", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_HTTPS_PORT}", "authority": "proxybridge-testlab.test", "path": "/probe", "use_tls": true, "server_name": "proxybridge-testlab.test", "ca_path": "${PB_PROTOCOL_CA_PEM}" }, "expected": { "status_code": 200 } }
    },
    {
      "id": "protocol-https-block", "title": "HTTPS over HTTP/1.1 follows BLOCK", "protocol": "TCP", "action": "BLOCK", "port_expression": "${PB_PROTOCOL_HTTPS_PORT}", "remote_port": "${PB_PROTOCOL_HTTPS_PORT}", "tags": ["https", "http1", "tls"], "requires": ["server_tls_pki"],
      "protocol_worker": { "plugin_id": "protocol-http", "protocol_family": "http1", "transport": "TCP", "evidence_profile_id": "http1-transaction", "parameters": { "remote_host": "${PB_VPS_IPV4}", "remote_port": "${PB_PROTOCOL_HTTPS_PORT}", "authority": "proxybridge-testlab.test", "path": "/probe", "use_tls": true, "server_name": "proxybridge-testlab.test", "ca_path": "${PB_PROTOCOL_CA_PEM}" }, "expected": {} }
