    },
    {
      "id": "protocol-http2-block", "title": "HTTP/2 follows BLOCK", "protocol": "TCP", "action": "BLOCK", "port_expression": "${PB_PROTOCOL_HTTP2_PORT}", "remote_port": "${PB_PROTOCOL_HTTP2_PORT}", "tags": ["http2"], "requires": ["server_http2"],
