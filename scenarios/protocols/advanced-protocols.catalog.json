{
  "schema_version": 1,
  "catalog_id": "protocol-advanced",
  "defaults": {
    "enabled": true,
    "executor_kind": "protocol-worker",
    "implementation_status": "EXECUTABLE",
    "implementation_reason": "A pinned protocol worker and controlled TestLab origin validate the application protocol with independent client, server and route evidence.",
    "family": 4,
    "selector": "basename",
    "socket_mode": "connected",
    "tags": ["synthetic", "correctness", "protocol-aware", "milestone-13"],
    "requires": ["protocol_worker", "server_python_protocols", "server_tls_pki"],
    "mock_fixture_id": "protocol-generated",
    "timeout_ms": 10000
  },
  "scenarios": [
